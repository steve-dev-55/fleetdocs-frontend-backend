# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/fleetdocs
# For production: postgresql+asyncpg://user:pass@host:port/dbname

# JWT
JWT_SECRET=change-this-to-a-32-char-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080  # 7 days

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# File storage (local for dev, S3-compatible for prod)
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20

# Mistral AI (optional, for OCR)
MISTRAL_API_KEY=

# Stripe (optional)
STRIPE_SECRET_KEY=

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@fleetdocs.africa
